{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "accepted"
        },
        "backend": {
          "type": "string",
          "enum": [
            "mlx-metal",
            "mlx-cuda",
            "mlx-cpu"
          ]
        },
        "engineVersion": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]{1,64}$"
        },
        "chunks": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "backend",
        "engineVersion",
        "chunks"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "progress"
        },
        "stage": {
          "type": "string",
          "enum": [
            "quick",
            "deep",
            "scoring"
          ]
        },
        "done": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "stage",
        "done",
        "total"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sentences"
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "signals": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "e1",
                    "e2",
                    "e3",
                    "e4",
                    "e5",
                    "e6",
                    "e7",
                    "stylometry"
                  ]
                }
              }
            },
            "required": [
              "start",
              "end",
              "score",
              "signals"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "result"
        },
        "result": {
          "type": "object",
          "properties": {
            "lenses": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "number",
                  "const": 1
                },
                "turnitin": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "masked"
                        },
                        {
                          "type": "number",
                          "const": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 20,
                          "maximum": 100
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "gptzero": {
                  "type": "string",
                  "enum": [
                    "low",
                    "mixed",
                    "high"
                  ]
                },
                "zerogpt": {
                  "type": "string",
                  "enum": [
                    "low",
                    "mixed",
                    "high"
                  ]
                },
                "grammarly": {
                  "type": "string",
                  "enum": [
                    "low",
                    "mixed",
                    "high"
                  ]
                },
                "veriguide": {
                  "type": "string",
                  "enum": [
                    "low",
                    "mixed",
                    "high"
                  ]
                }
              },
              "required": [
                "version",
                "turnitin",
                "gptzero",
                "zerogpt",
                "grammarly",
                "veriguide"
              ],
              "additionalProperties": false
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "interval": {
              "type": "object",
              "properties": {
                "low": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "high": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "low",
                "high"
              ],
              "additionalProperties": false
            },
            "band": {
              "type": "string",
              "enum": [
                "low",
                "mixed",
                "high"
              ]
            },
            "wordCount": {
              "type": "integer",
              "minimum": 150,
              "maximum": 5000
            },
            "signals": {
              "anyOf": [
                {
                  "minItems": 4,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "enum": [
                          "e1",
                          "e2",
                          "e3",
                          "e4",
                          "e5",
                          "e6",
                          "e7",
                          "stylometry"
                        ]
                      },
                      "value": {
                        "type": "number"
                      },
                      "humanReference": {
                        "type": "number"
                      },
                      "samples": {
                        "minItems": 2,
                        "maxItems": 16,
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "id",
                      "value",
                      "humanReference"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "minItems": 8,
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "enum": [
                          "e1",
                          "e2",
                          "e3",
                          "e4",
                          "e5",
                          "e6",
                          "e7",
                          "stylometry"
                        ]
                      },
                      "value": {
                        "type": "number"
                      },
                      "humanReference": {
                        "type": "number"
                      },
                      "samples": {
                        "minItems": 2,
                        "maxItems": 16,
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "id",
                      "value",
                      "humanReference"
                    ],
                    "additionalProperties": false
                  }
                }
              ]
            },
            "flags": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "invisible",
                  "homoglyph",
                  "esl",
                  "laundering"
                ]
              }
            },
            "sentences": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "signals": {
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "e1",
                        "e2",
                        "e3",
                        "e4",
                        "e5",
                        "e6",
                        "e7",
                        "stylometry"
                      ]
                    }
                  }
                },
                "required": [
                  "start",
                  "end",
                  "score",
                  "signals"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "index",
            "interval",
            "band",
            "wordCount",
            "signals",
            "flags"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "too_short",
            "too_long",
            "not_english",
            "busy",
            "internal"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "code",
        "retryable"
      ],
      "additionalProperties": false
    }
  ],
  "title": "InferenceEvent"
}
